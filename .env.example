# ============================================================
#  کانفیگ کنسول وب AI — همه‌ی مقادیر خالی هستند یعنی «از کانفیگ
#  سیستم استفاده کن» (رفتار فعلی). هر گزینه که پر کنید همان را
#  جایگزین می‌کند؛ بقیه همچنان از تنظیمات سیستم خوانده می‌شوند.
#  بعد از تغییر، سرور را یک بار ری‌استارت کنید.
# ============================================================

# ---- عمومی ----
# پورت و آدرس سرور (پیش‌فرض: 127.0.0.1:3000 — فقط دسترسی محلی)
# HOST=127.0.0.1
# PORT=3000

# پوشه‌ی کاری پیش‌فرض برای گفتگوهای جدید (خالی = پوشه‌ی کاربر)
# WORKDIR=C:\projects

# ---- Claude Code ----
# دستور claude (خالی = claude از PATH سیستم)
# CLAUDE_CMD=claude

# مدل پیش‌فرض (خالی = مدل پیش‌فرض CLI خودتان)
# CLAUDE_MODEL=opus

# حالت دسترسی — فقط وقتی CLAUDE_SKIP_PERMISSIONS=0 باشد اعمال می‌شود
# گزینه‌ها: acceptEdits | auto | plan | bypassPermissions | manual
# CLAUDE_PERMISSION_MODE=acceptEdits

# با 1 = بدون هیچ پرامپت دسترسی‌ای اجرا می‌شود (خطرناک؛ مثل نسخه‌ی مرجع)
# CLAUDE_SKIP_PERMISSIONS=0

# آرگومان‌های اضافی که به claude پاس می‌شوند
# مثال: CLAUDE_EXTRA_ARGS=--allowedTools "Read Bash Grep"

# فهرست مدل‌های fallback در UI (با کاما)
# CLAUDE_MODELS=opus,sonnet,haiku

# پنجره‌ی زمینه برای نمایش درصد مصرف (پیش‌فرض: 200000)
# CLAUDE_CONTEXT_WINDOW=200000

# ---- Codex ----
# دستور codex (خالی = codex از PATH سیستم)
# CODEX_CMD=codex

# پوشه‌ی CODEX_HOME (خالی = ~/.codex سیستم)
# CODEX_HOME=C:\Users\YourUser\.codex

# آرگومان‌های پیشوندی قبل از exec — آینه‌ی لانچر سفارشی مثل codexx
# (خالی = از config.toml خودکار تشخیص داده می‌شود: اگر پرووایدر proxy
#  داشت همان mirror می‌شود، وگرنه بدون پیشوند اجرا می‌شود)
# مثال mirror دستی: CODEX_EXEC_PREFIX_ARGS=-c model_provider=proxy --search

# اگر CODEX_CMD شما alias/function شلی است، با این در شل resolve می‌شود
# مثال: CODEX_SHELL_WRAP=bash -ic

# سندباکس Codex: read-only | workspace-write | danger-full-access
# CODEX_SANDBOX=workspace-write

# با 1 = بدون سندباکس و تأییدیه اجرا می‌شود (خطرناک)
# CODEX_BYPASS=0

# مدل پیش‌فرض (خالی = از config.toml شما)
# CODEX_MODEL=gpt-5.6-sol

# آرگومان‌های اضافی codex
# CODEX_EXTRA_ARGS=

# فهرست مدل‌های fallback (وقتی کشف زنده در دسترس نباشد)
# CODEX_MODELS=gpt-5-codex,gpt-5,o3

# کلیدهایی که لانچر سفارشی شما inline ست می‌کند را اینجا بگذارید تا به
# پروسه‌ی codex پاس شوند (توکن داخل config.toml نیاز به این کار ندارد)
# PROXY_API_KEY=
